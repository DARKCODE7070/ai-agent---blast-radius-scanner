        {
          "name": "marketing.publish_approved_promotion",
          "description": "Publish a promotion after approval.",
          "inputSchema": { "type": "object" },
          "scopes": ["marketing:promotions:publish"],
          "blast_radius": { "access": "write", "reaches": "live_promotions", "data_trust": null, "requires_human_approval": true, "sensitivity": 3, "irreversibility": 3 }
