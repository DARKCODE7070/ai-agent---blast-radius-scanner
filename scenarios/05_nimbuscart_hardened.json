        {
          "name": "ops.create_alert_draft",
          "description": "Create a draft operational alert for human review.",
          "inputSchema": { "type": "object" },
          "scopes": ["ops:alerts:draft"],
          "blast_radius": { "access": "write", "reaches": "ops_alert_drafts", "data_trust": null, "requires_human_approval": false, "sensitivity": 2, "irreversibility": 1 }
